# secops-guard - do not run package lifecycle scripts during npm install
# Requires: any npm version.
# This is the single highest-value npm setting: every npm worm of the last two years
# (Shai-Hulud, Shai-Hulud 2.0) ran from a preinstall/postinstall script.
#
# TRADEOFF: packages with native addons (esbuild, sharp, better-sqlite3, puppeteer)
# will not build or download their binary. Rebuild one on demand:
#     npm rebuild <pkg> --foreground-scripts
# Opt out entirely with the installer flag -SkipIgnoreScripts / --skip-ignore-scripts,
# or delete this line from your ~/.npmrc.
ignore-scripts=true
