{
  "description": "secops-guard hooks",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/plugin-integrity.js"], "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.js"], "timeout": 10 } ] },
      { "matcher": "Bash|PowerShell",
        "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-dangerous.js"], "timeout": 10 } ] },
      { "matcher": "Bash|PowerShell",
        "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dep-gate.js"], "timeout": 150, "onFailure": "block" } ] },
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/manifest-gate.js"], "timeout": 60 } ] },
      { "matcher": "Bash|PowerShell",
        "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/build-gate.js"], "timeout": 120 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post-install-scan.js"], "timeout": 120 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/build-gate.js"], "timeout": 120 }
        ] }
    ]
  }
}
